# Local development can use the defaults in config/settings.py.
# Copy this file to .env and change values for a real deployment.
# Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_BASE_URL=http://127.0.0.1:8000

# sqlite (default) or postgres
DB_ENGINE=sqlite

# Used only when DB_ENGINE=postgres
POSTGRES_DB=splitmate
POSTGRES_USER=splitmate
POSTGRES_PASSWORD=splitmate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Every account email, Gmail or otherwise, is sent through this Gmail account.
# EMAIL_HOST_PASSWORD is a Gmail app password, not the normal Gmail password.
# Leave the password blank in this example. Put the real one only in .env.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=ganeshmaheshwaram2005@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SplitMate <ganeshmaheshwaram2005@gmail.com>

# Optional. When unset, the process-local memory cache is used.
REDIS_URL=

# Set to true only behind HTTPS.
ENABLE_HSTS=false
CSRF_TRUSTED_ORIGINS=

# Receipt OCR is optional and off unless both flags work in this environment.
ENABLE_OCR=false
